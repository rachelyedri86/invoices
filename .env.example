# העתיקו את הקובץ הזה ל-.env.local ומלאו את הערכים. הקובץ .env.local לא עולה ל-git.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...). שרת בלבד!
SUPABASE_SECRET_KEY=
# Supabase → כפתור Connect למעלה → Session pooler. להחליף את [YOUR-PASSWORD] בסיסמת מסד הנתונים
SUPABASE_DB_URL=

# console.anthropic.com → API Keys. שרת בלבד!
ANTHROPIC_API_KEY=

# כתובת המייל שלך. משתמשי הדמו יקבלו כתובות כמו you+employee@gmail.com
SEED_EMAIL=
# חייב להיות yes כדי להריץ את ה-seed (npm run db:seed). הוא יוצר משתמשי דמו, כולל אדמין, במסד שאליו מצביע SUPABASE_URL
SEED_CONFIRM=

# resend.com → API Keys (מתחיל ב-re_). שרת בלבד! בלי המפתח המיילים פשוט לא נשלחים
RESEND_API_KEY=
# כתובת השולח. עד שמאמתים דומיין ב-Resend אפשר רק onboarding@resend.dev
EMAIL_FROM=חשבוניות <onboarding@resend.dev>
# לבדיקות: כל המיילים יישלחו לכתובת הזו (Resend בלי דומיין מאומת שולח רק לבעל החשבון). למחוק בייצור
EMAIL_TEST_RECIPIENT=
# בייצור EMAIL_TEST_RECIPIENT לא נלקח בחשבון, אלא אם הערך כאן הוא 1
EMAIL_TEST_RECIPIENT_FORCE=

APP_URL=http://localhost:3000

# ----- בדיקות (ראו tests/README.md) -----
# mock = תשובות שמורות מ-tests/fixtures במקום קריאה ל-Claude. עובד רק כש-NODE_ENV אינו production. ריק = Claude כרגיל
EXTRACTION_PROVIDER=
# 1 = מתיר את ה-mock גם בייצור. לא להגדיר בייצור אלא אם יודעים בדיוק למה
ALLOW_EXTRACTION_MOCK=
# טוקן fine-grained של GitHub לריפו הזה בלבד, עם Actions: Read and write. שרת בלבד! מאפשר לאדמין להפעיל את הבדיקות המלאות ממסך "בדיקות"
GITHUB_TOKEN=
# הריפו שבו רצות הבדיקות המלאות. ברירת מחדל: rachelyedri86/invoices
GITHUB_REPO=
