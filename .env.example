# העתיקו את הקובץ הזה ל-.env.local ומלאו את הערכים. הקובץ .env.local לא עולה ל-git.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...). שרת בלבד!
SUPABASE_SECRET_KEY=
# Supabase → כפתור Connect למעלה → Session pooler. להחליף את [YOUR-PASSWORD] בסיסמת מסד הנתונים
SUPABASE_DB_URL=

# console.anthropic.com → API Keys. שרת בלבד!
ANTHROPIC_API_KEY=

# כתובת המייל שלך. משתמשי הדמו יקבלו כתובות כמו you+employee@gmail.com
SEED_EMAIL=

APP_URL=http://localhost:3000
